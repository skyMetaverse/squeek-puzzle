# 前端默认连 Sepolia 的正式部署，不需要任何环境变量。
# 下面的值只是"默认值是什么"的说明；要覆盖时复制成 web/.env.local（本地）
# 或在 Vercel 项目里配置环境变量。

# ---- Sepolia（默认值）----
# VITE_CHAIN_ID=11155111
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_PUZZLE_ADDRESS=0x49d0227b7e6d94a3c2c321b1c5770ab39149c391
# VITE_CORE_ADDRESS=0x74665daeca35a2303e767e76a2ff1fb6f93e119f
# VITE_DEPLOY_BLOCK=12025550

# ---- 本地 anvil ----
# 复制下面四行到 web/.env.local 即可切到本地链
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_PUZZLE_ADDRESS=0xdc64a140aa3e981100a9beca4e685f962f0cf6c9
# VITE_CORE_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
